{
  "copilot_url": "https://m365.cloud.microsoft/chat/",
  "browser_channel": "msedge",
  "headless": false,
  "browser_startup": "lazy",
  "reply_timeout_seconds": 180,
  "reply_hard_timeout_seconds": 1200,
  "stable_seconds": 3,
  "poll_interval_seconds": 0.35,
  "diagnostics": true,
  "diagnostic_html": false,
  "default_model": "copilot-auto",
  "api_token": "",
  "server": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "agent": {
    "enabled": true,
    "workspace": "workspace",
    "workspace_roots": [],
    "session_store": "data/agent.db",
    "max_total_steps": 1000,
    "max_steps_per_conversation": 80,
    "max_conversation_rollovers": 25,
    "context_token_budget": 80000,
    "compact_at_tokens": 35000,
    "rollover_at_tokens": 55000,
    "keep_recent_steps": 8,
    "max_summary_tokens": 5000,
    "max_context_chars": 240000,
    "auto_rollover": true,
    "min_steps_before_rollover": 20,
    "auto_compact": true,
    "auto_resume": true,
    "session_timeout_seconds": 86400,
    "completed_session_retention_days": 30,
    "max_sessions": 100,
    "max_parse_failures": 5,
    "max_actions_per_turn": 4,
    "tool_visibility": "auto",
    "allow_copilot_file": true,
    "max_service_unavailable": 30,
    "service_retry_base_seconds": 30,
    "service_retry_max_seconds": 600,
    "service_retry_window_seconds": 3660,
    "max_read_chars": 120000,
    "max_write_chars": 200000,
    "allow_delete": false,
    "allow_python": false,
    "allow_office": true,
    "allow_outlook": false,
    "allow_outlook_send": false,
    "allow_skill_write": true,
    "allow_memory_write": true,
    "outlook_url": "https://outlook.office.com/mail/",
    "python_timeout_seconds": 20,
    "snapshot_retention": 50,
    "agent_md_max_chars": 8000,
    "allow_self_upgrade": false,
    "self_upgrade_paths": [
      "cbp/",
      "webui/",
      "scripts/",
      "docs/",
      "tests/",
      "app.py",
      "start.py",
      "install.py",
      "requirements.txt",
      "AGENT.md",
      "README.md",
      "config.example.json"
    ]
  },
  "models": {},
  "providers": {
    "deepseek": {},
    "kimi": {},
    "myapi": {
      "base_url": "https://example.com/v1",
      "api_key_env": "MYAPI_KEY",
      "models": [
        "my-model"
      ],
      "description": "自建 OpenAI 兼容网关"
    }
  },
  "markers": {
    "assistant_turn": [
      "Copilot said:"
    ],
    "user_turn": [
      "You said:"
    ]
  }
}
