# Gantry 本地密钥与环境变量（复制为 .env 再填，**不要**把 .env 提交进 git）
#
# 读取优先级：系统环境变量 > 本文件 > config.json 里的字面量。
# config.json 里用 "${VAR}" 引用本文件的变量，例如：
#   "api_token": "${GANTRY_TOKEN}"

# 访问令牌（WebUI/CLI 都要带，X-Gantry-Token 头）
GANTRY_TOKEN=

# 提供商 API key（providers 段里用 "${DEEPSEEK_API_KEY}" 引用）
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=

# 浏览器/端口等也可以用环境变量覆盖（GANTRY_PORT / GANTRY_EVENT_SOURCE / …）
# GANTRY_PORT=8765
