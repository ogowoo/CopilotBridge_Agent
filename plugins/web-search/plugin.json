{
  "name": "web-search",
  "version": "0.1.0",
  "description": "联网搜索：DuckDuckGo 免 key，可选 Brave / Tavily / Serper（有 key 自动优选）",
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"}
  },
  "gantry": {
    "entry": "plugin.py",
    "permissions": ["tools", "api"],
    "contributes": {
      "tools": ["web_search"],
      "api": ["GET api/search"]
    },
    "config": {
      "backend": "auto",
      "max_results": 6
    }
  }
}
