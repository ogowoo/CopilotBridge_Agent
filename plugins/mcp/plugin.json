{
  "name": "mcp",
  "version": "0.2.0",
  "description": "MCP 客户端：连接 MCP server（stdio 或 HTTP），把其工具与资源注册成 Agent 工具（mcp__<server>__<tool>）",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "cbp": {
    "entry": "plugin.py",
    "permissions": [
      "tools",
      "api",
      "storage",
      "ui"
    ],
    "contributes": {
      "tools": [
        "mcp_list",
        "mcp_call",
        "mcp_read_resource"
      ],
      "api": [
        "GET api/list",
        "GET api/resources",
        "POST api/add",
        "POST api/remove",
        "POST api/reload",
        "POST api/call"
      ],
      "panels": [
        "servers"
      ]
    },
    "i18n": {
      "en": {
        "MCP 服务器": "MCP servers",
        "连接状态、工具与资源": "Connection state, tools and resources"
      }
    }
  }
}
